PORT=8080
ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=institute_portal
DB_SSLMODE=disable
JWT_SECRET=super-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=*
DEFAULT_INSTITUTION_ID=11111111-1111-1111-1111-111111111111
DEFAULT_DEPARTMENT_ID=22222222-2222-2222-2222-222222222222

# SMTP / Email — required for forgot-password emails in production
# Generate a Gmail App Password at: myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@nith.ac.in
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=NIT Hamirpur Portal <your-email@nith.ac.in>
FRONTEND_URL=https://tempcse.nith.ac.in
