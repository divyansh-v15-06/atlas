# ==============================================================================
# Institute Portal - Production Environment Configuration Template
# Copy this file to .env on your deployment server: cp .env.production.example .env
# ==============================================================================

# Application Ports (Proxied from host Apache2 at tempcse.nith.ac.in)
PORT_BINDING=127.0.0.1:3000

# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE
DB_NAME=institute_portal

# Backend Authentication & Security
JWT_SECRET=GENERATE_A_RANDOM_64_CHAR_SECRET_KEY_HERE
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=*

# Institutional Defaults
DEFAULT_INSTITUTION_ID=11111111-1111-1111-1111-111111111111
DEFAULT_DEPARTMENT_ID=22222222-2222-2222-2222-222222222222

# Frontend Build Arguments
NEXT_PUBLIC_API_URL=/api/v1
